# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required: Anthropic API (server-side only, never shipped to the browser) ---
ANTHROPIC_API_KEY=

# --- Embeddings backend: "local" (free, no key) or "voyage" ---
# local  -> sentence-transformers/all-MiniLM-L6-v2, runs on CPU, zero cost
# voyage -> voyage-4-lite via the Voyage API (200M free tokens at time of writing)
EMBEDDINGS_BACKEND=local
VOYAGE_API_KEY=

# --- Access control: shared secret gate for the deployed demo (section 7) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SHARED_SECRET=

# --- CORS: strict allowlist, never a wildcard ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_PER_HOUR=20

# --- Paths (relative to the backend/ directory) ---
CORPUS_DIR=../corpus
DATA_DIR=./data
