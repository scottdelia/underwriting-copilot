# --- Secrets: never commit. See section 7 of the spec. ---
.env
.env.local
*.pem
*.key

# --- Carrier / source documents: never commit. See section 8 of the spec. ---
# Even though this POC ships a synthetic corpus, the ignore rule stays so the
# repo cannot accumulate real carrier PDFs if the corpus is ever swapped.
corpus/
!corpus/.gitkeep
!corpus/MANIFEST.md

# --- Generated indexes and databases (rebuildable from the corpus) ---
backend/data/
*.sqlite3
*.db
chroma/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node ---
node_modules/
dist/
.vite/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
